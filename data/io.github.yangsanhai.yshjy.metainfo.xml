    <keyword>zip</keyword>
    <keyword>7z</keyword>
    <keyword>rar</keyword>
    <keyword>解压</keyword>
    <keyword>压缩包</keyword>
    <keyword>伪装</keyword>
  </keywords>

  <content_rating type="oars-1.1" />

