#compdef yshjy yshys
# ⚠️ 本文件由 scripts/gen-cli-assets.py 生成，**别手改** —— 改了下次打包就被覆盖。
# 要加/改选项：改 src/cli_spec.rs 的 OPTS 表，然后跑一次生成器。
# zsh 补全 —— yshjy（杨三海解压）
#
# 装法（用户级，不用 sudo）：
#   cp scripts/completions/_yshjy ~/.local/share/zsh/site-functions/_yshjy

_yshjy() {
    _arguments -s -S \
        '(-l --list)'{-l,--list}'' \
        '--rescue' \
        '--extract-cover' \
        '(-o --dest)'{-o,--dest}'[解压到哪]:目录:_files -/' \
        '(-p --password)'{-p,--password}'[解压码 / 打包密码]:密码:' \
        '--password-file[密码本：每行一个（# 注释），只对这次命令有效]:文件:_files' \
        '--no-auto-password[不自动从「说明.txt」和密码本找解压码]' \
        '--no-auto-password-notes[只关「从说明.txt 抓解压码」这一档]' \
        '--no-auto-password-book[只关「试自己的密码本」这一档]' \
        '--encoding[手动指定文件名编码（auto / gbk / big5 / sjis / utf-8；gb18030、shift-jis 是别名）]:编码:(utf-8 gbk big5 sjis)' \
        '--select[只解一部分：]:条件:' \
        '--candidate[一个文件里藏着好几处时，指定解哪一处（偏移＝扫描结果里那个数字）]:偏移:_files' \
        '--pick[全屏勾选要解哪些（↑↓ 选 · 空格勾 · a 全选 · Enter 确认）]' \
        '(-j --jobs)'{-j,--jobs}'[同时跑几个]:N:(1 2 4 8)' \
        '(-f --force)'{-f,--force}'[跳过解压前的磁盘空间预检（空间不够时会直接拒绝开始）]' \
        '--test[只测不写：完整解码 + 校验，一个字节都不落盘（查包完不完整用）]' \
        '--no-smart-dir[关掉「智能解压」：默认会看包里有没有单一顶层目录来决定]' \
        '--keep[打包时保留中间 ZIP（排错用）]' \
        '--trash-source[解完把原包移进回收站（能还原）]' \
        '--delete-source[解完永久删除原包（不可恢复；会先问一次，非交互直接拒绝）]' \
        '--split[打包时分卷（如 2G / 500M，也认纯字节数）]:大小:' \
        '--format[打包成普通归档（不加外壳）：zip / tar.gz / tar.zst。给了就是普通压缩，不给还是伪装包]:zip|tar.gz|tar.zst:(zip tar.gz tar.zst)' \
        '--name[改产物的文件名（伪装成 电影.2026.1080p.mp4 这种）；只换名字不换位置，位置用 -o]:名称:_files' \
        '--tweak-time[防炸链：把条目时间戳打乱（每次都不一样），网盘就不会判成同一个文件；默认关]' \
        '--level:0-9:' \
        '--layout:L1|L2|L4:(L1 L2)' \
        '--decoy[打包时撒 N 段干扰数据（最多 64 段，默认 0 = 不打）]:N:' \
        '--decoy-size[每段多大（4K–1M，默认 16K）]:大小:' \
        '--decoy-signatures[每段里夹一枚假特征码（骗扫描器；默认关）]' \
        '--cover[用自己的图片/视频当封面]:文件:_files' \
        '--tail[打包用"尾部追加"布局]' \
        '--no-checksum[不生成 .sha256 校验和]' \
        '--no-readme[不生成 .说明.txt]' \
        '--sfx' \
        '--sfx-linux' \
        '--json[按行输出事件流/结果（给脚本用）]' \
        '(-q --quiet)'{-q,--quiet}'[只输出结果（脚本用）]' \
        '--no-color[不上色（管道 / 日志友好）]' \
        '--verbose' \
        '--log[把日志写进文件（报错时发给开发者）]:文件:_files' \
        '--lang[切换界面语言（如 en、ja、ko、ru、es）]:语言:(zh-CN zh-TW en-US ja-JP ko-KR ru-RU es-ES)' \
        '--config[用指定的配置文件]:文件:_files' \
        '--show-config[看当前配置（配置文件在哪、各项现在是什么值）]' \
        '--caps[看各格式的能力表（能解 / 能打包 / 加密 / 分卷 / 续传）]' \
        '--import-passwords[导入密码本（每行一个解压码，# 开头是注释；Tab 分隔取第一列，自动去重）]:文件:_files' \
        '--report' \
        '--no-paths' \
        '(-h --help)'{-h,--help}'' \
        '(-V --version)'{-V,--version}'' \
        '1:要处理的文件或目录（jy=解压 / ys=打包）:_files' \
        '*:更多文件或目录:_files'
}

_yshjy "$@"
